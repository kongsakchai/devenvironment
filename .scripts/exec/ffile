#!/bin/bash

if [ -n "$2" ]; then
    root=$2
else
    root=$(pwd)
fi

args=$1

if [ -n "$root" ] && [ ! -d "$root" ]; then
    echo "not_found"
    exit 1
elif [ -d "$root/$args" ]; then
    echo "$root/$args" | sed "s#//#/#"
    exit 0
fi

if command -v -- fd >/dev/null 2>&1; then
    select=$(
        fd "" --type f --no-ignore $root \
            --exclude "node_modules" --exclude "build" --exclude ".git" |
            sed "s#$root/*##" |
            fzf --layout reverse --info inline --query "$args"
    )
elif command -v -- fdfind >/dev/null 2>&1; then
    select=$(
        fdfind "" --type f --no-ignore $root \
            --exclude "node_modules" --exclude "build" --exclude ".git" |
            sed "s#$root/*##" |
            fzf  --layout reverse --info inline --query "$args"
    )
else
    echo "fd_not_found"
    exit 1
fi

if [ -z "$select" ]; then
    exit 1
fi

echo "$root/$select" | sed "s#//#/#"
exit 0
